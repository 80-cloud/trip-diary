# --- MySQL (Docker) ---
MYSQL_ROOT_PASSWORD=please_change_me
MYSQL_DATABASE=trip_diary_dev
MYSQL_USER=trip
MYSQL_PASSWORD=trip_password
MYSQL_PORT=3316
# TLS が必須の DB (TiDB Cloud など) につなぐときだけ設定する。手元の MySQL では設定しない
# MYSQL_SSL_MODE=verify_identity

# --- Rails ---
# ⚠ 本番デプロイ時は必ず "production" に変更すること
#    (development のままだと seeds.rb が本番 DB に動く重大リスク。E-H3 / docs/セキュリティ自己監査.md §3)
RAILS_ENV=development
RAILS_PORT=3010
# `cd backend && bundle exec rails secret` で生成して貼り付け
SECRET_KEY_BASE=replace_me_with_rails_secret
# JWT 署名鍵 (`openssl rand -hex 64` で生成)
JWT_SECRET=replace_me_with_random_64_hex

# --- 公開環境だけで設定する (手元では設定しない) ---
# 実行時に Rails が読む変数。公開先のサービスの環境変数に入れる
# 回数制限で X-Forwarded-For の先頭を訪問者の IP として数える。先頭を訪問者の IP にする中継 (Render) の内側でだけ 1
# TRUST_FIRST_FORWARDED_IP=1
# アプリ本体 (Puma) の中でジョブを動かす (画像の削除など)
# SOLID_QUEUE_IN_PUMA=1
# 通常のサインアップを止める (false のとき 403 を返す)
# SIGNUP_ENABLED=false
# production で demo:seed / demo:reset を流すときだけ 1
# DEMO_SEED_CONFIRM=1
# 画像の置き場 (Cloudinary)。値は Cloudinary の管理画面で確かめ、このファイルには書かない
# CLOUDINARY_URL=cloudinary://<API Key>:<API Secret>@<Cloud name>
# ビルド時に Nuxt が読む変数。画面は nuxt generate で作るため、実行時に変えても効かない
# NUXT_PUBLIC_SIGNUP_ENABLED=false

# --- Nuxt ---
NUXT_PORT=3011
NUXT_PUBLIC_API_BASE=http://localhost:3010/api/v1
